# ---------------------------------------------------------------------------
# droPINion — environment variables. Copy to `.env` for local development.
# ---------------------------------------------------------------------------

# --- Database (docker compose up -d starts PostGIS with these credentials) ---
DATABASE_URL=postgres://opinion:opinion@localhost:5432/opinion
# Max connections in the app's postgres pool (default 10).
# DATABASE_POOL_MAX=10

# --- Auth (better-auth) -----------------------------------------------------
# REQUIRED in production, >= 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Public base URL of the app (used for cookies, CSRF origin checks, links).
BETTER_AUTH_URL=http://localhost:3000
# Extra trusted origins for auth requests, comma separated (optional).
# `opinionmobile://` (the native app) is always trusted; `exp://` only in dev.
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Site --------------------------------------------------------------------
# Canonical public URL (SEO, OG images, share links). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reverse proxy -----------------------------------------------------------
# Number of proxies in front of the app that append to X-Forwarded-For
# (Traefik on Dokploy = 1). The client IP used for rate limiting is the N-th
# entry from the right, so clients can't spoof it. Default 1.
TRUSTED_PROXY_HOPS=1

# --- Uploads -----------------------------------------------------------------
# Where re-encoded user uploads are stored (mount a volume here in prod).
# Default: ./storage/uploads
# UPLOAD_DIR=/app/storage/uploads

# --- Email (Resend) — optional -------------------------------------------------
# Used for password-reset / email-verification / change-email codes.
# When unset, codes are printed to the server console in development.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="droPINion <no-reply@example.com>"

# --- Push notifications (Expo) — optional ------------------------------------
# Only needed if "enhanced push security" is enabled for the Expo project.
# EXPO_ACCESS_TOKEN=
